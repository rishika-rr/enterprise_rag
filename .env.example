# Copy to .env and fill in. Never commit .env (NFR-SEC-002).

# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=

# First administrator. Created only while no user exists; change the password
# after the first login (POST /v1/auth/password). Minimum 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- language model (any OpenAI-compatible endpoint) ------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
# A DeepSeek or Gemini model id as listed by the provider.
LLM_MODEL=deepseek/deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# --- retrieval --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# hybrid | dense | bm25
RETRIEVAL_MODE=hybrid
# cross_encoder (local reranking model) | none (reranking off)
RERANKER=cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=10
RERANK_TOP_K=5
MIN_RELEVANCE=0.01
MAX_CONTEXT_CHARS=12000
# Claim/citation pairs checked per answer. 0 disables citation verification.
MAX_VERIFICATIONS=8
VERIFICATION_WORKERS=8

# --- chunking ---------------------------------------------------------------
# fixed | recursive
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- storage ----------------------------------------------------------------
CHROMA_DB_PATH=data/chroma_db
APP_DB_PATH=data/app.db
UPLOAD_DIR=uploads
# Server directories administrators may ingest from (never the upload dir).
INGEST_ALLOWED_DIRS=data/raw

# --- limits -----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20
MAX_QUESTION_CHARS=2000
MAX_REQUEST_BYTES=65536
# Per user per minute on /v1/ask; per client+username on login. 0 = unlimited.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- identity ---------------------------------------------------------------
DEFAULT_TENANT=default
TOKEN_TTL_MINUTES=480
MIN_PASSWORD_LENGTH=10

# --- retention (days; 0 = keep until deleted) -------------------------------
AUDIT_RETENTION_DAYS=365
DOCUMENT_RETENTION_DAYS=0
LOG_RETENTION_DAYS=30

# --- service ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# text | json
LOG_FORMAT=text
# Load indexes and local models at boot (slower start, fast first query).
WARMUP_ON_START=false
